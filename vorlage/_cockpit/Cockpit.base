filters:
  and:
    - '!file.inFolder("templates")'
    - '!file.inFolder("archive")'
formulas:
  prio_rang: 'if(prio == "hoch", 1, if(prio == "mittel", 2, if(prio == "tief", 3, 4)))'
properties:
  zustaendig:
    displayName: Zuständig
  faellig:
    displayName: Fällig
  formula.prio_rang:
    displayName: Rang
views:
  - type: table
    name: Aufgaben
    filters:
      and:
        - 'file.inFolder("wiki/aufgaben")'
    groupBy:
      property: status
      direction: DESC
    order:
      - file.name
      - prio
      - faellig
      - zustaendig
    sort:
      - property: formula.prio_rang
        direction: ASC
  - type: table
    name: Meine Aufgaben
    filters:
      and:
        - 'file.inFolder("wiki/aufgaben")'
        - 'zustaendig == "ich"'
        - 'status == "offen"'
    order:
      - file.name
      - prio
      - faellig
    sort:
      - property: formula.prio_rang
        direction: ASC
  - type: table
    name: Für Claude
    filters:
      and:
        - 'file.inFolder("wiki/aufgaben")'
        - 'zustaendig == "Claude"'
        - 'status != "erledigt"'
    order:
      - file.name
      - faellig
  - type: table
    name: Shops
    filters:
      and:
        - 'file.inFolder("wiki/shops")'
    order:
      - file.name
      - file.folder
      - typ
      - beschreibung
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Business
    filters:
      and:
        - 'file.inFolder("wiki/business")'
    order:
      - file.name
      - beschreibung
  - type: cards
    name: Privat
    filters:
      and:
        - 'file.inFolder("wiki/privat")'
    order:
      - file.name
      - beschreibung
  - type: table
    name: Projekte
    filters:
      and:
        - 'file.inFolder("wiki/projekte")'
    order:
      - file.name
      - status
      - beschreibung
  - type: table
    name: Neue Quellen
    filters:
      and:
        - 'file.inFolder("sources")'
        - '!file.inFolder("sources/assets")'
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 10
  - type: table
    name: Zuletzt geändert
    filters:
      and:
        - 'file.inFolder("wiki")'
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 6
